OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=TOIR Dashboard Assistant
OPENROUTER_MOCK_ENABLED=false
# План правок отчётов ТОиР (JSON operations через OpenRouter; при отключении/mock — только эвристика)
REPORT_AI_EDIT_ENABLED=true
# Инструкции для POST /api/reports/:id/drafts проходят DLP так же, как поле question в /api/chat (аудит: report_edit_*).
API_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Окно Electron (npm run desktop): страница грузится как file://, API — отдельный процесс Node на API_PORT.
# Рекомендуется запуск через npm run desktop (передаётся npm_node_execpath); иначе в PATH должен быть node.

# DLP (Sprint 1)
DLP_ENABLED=true
DLP_BLOCK_ON_SECRETS=true
DLP_TOKEN_TTL_SEC=900
DLP_KEY_PROVIDER=auto
# Transition release: keep ephemeral fallback enabled, but monitor usage.
DLP_REQUIRE_CONFIGURED_KEY=false
DLP_ALLOW_EPHEMERAL_KEY=true
DLP_EPHEMERAL_ROLLOUT_STAGE=transition
DLP_EPHEMERAL_DISABLE_AFTER=next-release
# Provide one of DLP_MASTER_KEY_B64 / DLP_MASTER_KEY_HEX / DLP_MASTER_KEY.
# Example (base64 of 32 random bytes):
# DLP_MASTER_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DLP_MASTER_KEY_B64=
DLP_MASTER_KEY_HEX=
DLP_MASTER_KEY=
# Optional external providers (Sprint 4 hardening)
DLP_VAULT_KEY_B64=
DLP_VAULT_KEY_HEX=
DLP_VAULT_KEY=
DLP_KMS_KEY_B64=
DLP_KMS_KEY_HEX=
DLP_KMS_KEY=
# Optional file-based secrets:
DLP_MASTER_KEY_FILE=
DLP_VAULT_KEY_FILE=
DLP_KMS_KEY_FILE=

# Secret policy (Sprint 3): strict | monitor | off
SECRET_POLICY_MODE=strict

# ML-first DLP detector (Sprint 6: ml-all). The ML model is the primary
# source of truth for PII (PER/ORG/LOC). Regex backstop guarantees coverage
# for secrets, email/phone and equipment_code (defense in depth).
DLP_ML_ENABLED=true
DLP_ML_BACKEND=transformers
DLP_ML_MODEL=Xenova/bert-base-multilingual-cased-ner-hrl
# Optional pre-exported ONNX weights (see models/README.md).
DLP_ML_MODEL_DIR=
# Phase 1: monitor (don't block when ML is unavailable; regex backstop covers).
# Phase 2 (production target): closed (block PII routes when ML is unavailable).
DLP_ML_FAIL_MODE=monitor
DLP_ML_WARMUP_TIMEOUT_MS=25000
DLP_ML_TIMEOUT_MS=1500
DLP_ML_MAX_CHARS=4000
# Per-label thresholds; JSON object. Falls back to DLP_ML_THRESHOLD when missing.
DLP_ML_THRESHOLDS={"ml_person":0.6,"ml_org":0.7,"ml_location":0.7}
DLP_ML_THRESHOLD=0.7
# Regex-backstop is mandatory by default. Disable only for ML-only experiments.
DLP_REGEX_BACKSTOP_ENABLED=true

# Security audit log (JSONL)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/security-audit.log
AUDIT_LOG_MAX_STRING=300
AUDIT_LOG_UTF8_BOM=true
AUDIT_LOG_SCHEMA_VERSION=1

# Detailed filter trace (for test/debug)
FILTER_TRACE_LOG_ENABLED=false
FILTER_TRACE_LOG_PATH=logs/filter-trace.log
FILTER_TRACE_MAX_STRING=10000
FILTER_TRACE_LOG_SCHEMA_VERSION=1
FILTER_TRACE_LOG_REDACT=true
FILTER_TRACE_LOG_ROTATE_DAILY=true
FILTER_TRACE_LOG_ROTATE_MAX_BYTES=5242880
FILTER_TRACE_LOG_ROTATE_MAX_FILES=14

# Agent chat flow trace (front->back->model->back->front)
DLP_AGENT_FLOW_LOG_ENABLED=false
DLP_AGENT_FLOW_LOG_PATH=logs/dlp-agent-flow.log
DLP_AGENT_FLOW_MAX_STRING=30000
DLP_AGENT_FLOW_LOG_SCHEMA_VERSION=1
DLP_AGENT_FLOW_LOG_REDACT=true
DLP_AGENT_FLOW_LOG_ROTATE_DAILY=true
DLP_AGENT_FLOW_LOG_ROTATE_MAX_BYTES=5242880
DLP_AGENT_FLOW_LOG_ROTATE_MAX_FILES=14
DLP_AGENT_FLOW_MODEL_IO_VERBOSE=false
DLP_AGENT_FLOW_MODEL_PREVIEW_MAX=260

# Rate limit (Sprint 4 hardening)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BYPASS_LOCALHOST=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_CHAT_MAX=90
RATE_LIMIT_AGENT_MAX=45
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_AGENT_WINDOW_MS=60000
# Лимит запросов POST /api/reports/:id/drafts (инструкции AI-правки; как у чата, отдельное окно)
RATE_LIMIT_REPORT_EDIT_MAX=90
RATE_LIMIT_REPORT_EDIT_WINDOW_MS=60000

# -------------------------
# Recommended profiles
# -------------------------
# Release N (compatibility rollout):
# DLP_REQUIRE_CONFIGURED_KEY=false
# DLP_ALLOW_EPHEMERAL_KEY=true
# DLP_EPHEMERAL_ROLLOUT_STAGE=transition
# DLP_ML_FAIL_MODE=monitor
#
# Release N+1 (production target):
# DLP_REQUIRE_CONFIGURED_KEY=true
# DLP_ALLOW_EPHEMERAL_KEY=false
# DLP_EPHEMERAL_ROLLOUT_STAGE=enforced
# DLP_ML_FAIL_MODE=closed
